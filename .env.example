# ─── Supabase ───────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# SEGRETO — service_role: bypassa RLS. Solo server, mai nel bundle client.
SUPABASE_SECRET_KEY=sb_secret_...

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── Admin ──────────────────────────────────────────────────────────
# Email autorizzate al pannello /admin, separate da virgola.
# Alternativa preferibile: app_metadata.role = "admin" sull'utente Supabase.
ADMIN_EMAILS=admin@example.com

# ─── Cron ───────────────────────────────────────────────────────────
# SEGRETO. Se non impostato, /api/cron/* risponde 503 (fail-closed).
# Generare con: openssl rand -hex 32
CRON_SECRET=

# ─── Email (Resend) ─────────────────────────────────────────────────
RESEND_API_KEY=re_...
RESEND_FROM=noreply@simuniverse.it
